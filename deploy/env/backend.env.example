# Copy to /var/www/kiyim-chechak/backend/.env on EC2
# cp deploy/env/backend.env.example backend/.env  (then edit values)

NODE_ENV=production
PORT=3000

# Render PostgreSQL (or RDS) — External URL with SSL
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?schema=public&sslmode=require"

# Generate: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_32_CHAR_SECRET
JWT_EXPIRES_IN=7d

# EC2 public URL — replace with your Elastic IP or domain
# Example: http://13.45.67.89  or  https://kiyim-kechak.kahoot.uz
CORS_ORIGIN=https://kiyim-kechak.kahoot.uz

LOG_LEVEL=info
